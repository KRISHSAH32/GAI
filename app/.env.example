# Vidyashilp University AI Academic Advisor - Environment Variables

# Primary LLM Provider: Groq
GROQ_API_KEY=your_groq_api_key_here
PRIMARY_LLM_MODEL=openai/gpt-oss-120b

# Fallback LLM Provider: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
FALLBACK_LLM_MODEL=gemini-2.5-flash

# Optional: Host & Port for local Python backend if running standalone
PORT=8000
HOST=127.0.0.1
